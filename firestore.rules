rules_version = '2';

/* =========================================================================
   ZAHROUN — Firestore Security Rules
   =========================================================================
   HOW TO PUBLISH:
   1. Firebase Console -> Build -> Firestore Database -> "Rules" tab
   2. Replace everything there with the contents of this file
   3. Use the "Rules Playground" to run the checks listed in
      SECURITY-RULES-TESTS.md BEFORE clicking Publish
   4. Click "Publish"

   Model:
   - Public can READ products / categories / reviews (storefront)
   - Only signed-in users can manage their own data
   - Orders are readable only by their owner or an admin; guest tracking goes
     through the /api/track-order serverless function
   - Guests and signed-in users can CREATE orders, but only in a strictly
     validated shape (see orderShapeOk) — and never as already-paid/fulfilled
   - Only ADMINS (users/{uid}.role == "admin") can manage the catalog & orders

   WHAT THESE RULES CANNOT DO
   --------------------------
   Firestore rules cannot iterate list elements, so the per-item prices inside
   `items` cannot be validated here. A client can still submit an order whose
   items do not justify its subtotal. Closing that requires creating orders
   server-side (roadmap P3). What the rules below DO close:
     * role escalation (SEC-1)
     * orders that arrive already "delivered" / "verified" — which previously
       inflated loyalty tiers and poisoned revenue reports (SEC-4)
     * NaN / absurd / wrong-typed money values reaching the admin dashboard
     * oversized or wrong-shaped documents (which fed the admin XSS, SEC-3)
     * coupon usage-limit bypass and coupon-code harvesting (SEC-6)
     * order-counter griefing (SEC-12)
     * review rating forgery and loyalty tier/balance self-editing (SEC-13)
   ========================================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin check via Firestore role field — add new admins by setting users/{uid}.role = "admin"
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ---- User profiles -------------------------------------------------
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();

      // SEC-1 fix: the create rule previously placed NO constraint on `role`,
      // so anyone could self-register as an admin by writing their own profile
      // document directly (the update rule below pinned `role`, but a first
      // write is a CREATE, not an UPDATE). js/auth.js createUserProfile() is
      // the only legitimate creator and always writes role:"customer".
      allow create: if isOwner(uid)
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == 'customer');

      // The owner may edit their own profile (savedAddress, wishlist,
      // savedCart) but may never ADD or CHANGE `role`. Using affectedKeys()
      // rather than comparing values also means a legacy profile that somehow
      // has no `role` field is still editable by its owner — the old
      // `request.resource.data.role == resource.data.role` form errored on
      // such documents and locked those users out of their own profile.
      // The second branch lets a roleless profile self-heal to "customer".
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                            || (!('role' in resource.data)
                                && request.resource.data.role == 'customer')));

      allow delete: if isAdmin();
    }

    // ---- Catalog (public read, admin write) ----------------------------
    match /products/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- Coupons -------------------------------------------------------
    // SEC-6 fix, part 1: `get` stays public so a customer can validate a code
    // they already know, but `list` is admin-only — the old `read: if true`
    // let anyone download the entire coupon collection and harvest every code,
    // its value, minimum order and expiry.
    match /coupons/{id} {
      allow get:  if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      // SEC-6 fix, part 2: the old rule constrained WHICH key could change but
      // not HOW, so anyone could reset usedCount to 0 (bypassing maxUses
      // forever) or set it to a huge number (disabling the coupon for every
      // customer). Only a +1 step is allowed now, which is exactly what
      // js/coupon.js incrementCouponUsage() does via increment(1).
      allow update: if isAdmin()
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
                        && request.resource.data.usedCount is int
                        && request.resource.data.usedCount ==
                             (('usedCount' in resource.data) ? resource.data.usedCount : 0) + 1);
    }

    // ---- Order number counter ------------------------------------------
    // Atomic 6-digit sequential order IDs (100001, 100002, …).
    // Public can read + advance it (guests place orders too).
    // SEC-12 fix: the counter may now only advance by exactly 1. Previously
    // any forward jump was allowed, so a single anonymous write could push
    // order numbers to 9 digits and break the "6-digit Order ID" tracking UX.
    // js/orders.js getNextOrderNum() always writes current + 1, and seeds a
    // missing counter at 100001.
    match /counters/{id} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasOnly(['current'])
                    && request.resource.data.current is int
                    && request.resource.data.current == 100001;
      allow update: if request.resource.data.keys().hasOnly(['current'])
                    && request.resource.data.current is int
                    && request.resource.data.current == resource.data.current + 1;
      allow delete: if isAdmin();
    }

    // ---- Orders --------------------------------------------------------
    // SEC-4 fix. The order document is written by the customer's browser, so
    // every field is untrusted input. The helpers below pin the fields that
    // decide whether an order counts as paid or fulfilled, enforce types and
    // sane bounds (which also rejects NaN, since NaN fails every comparison),
    // and cap string/list sizes so a hostile order cannot carry a huge or
    // wrong-typed payload into the admin dashboard.
    //
    // The allow-list below is the EXACT field set written by js/orders.js
    // saveOrder() (verified against a live capture of a checkout that used a
    // coupon, a free gift, loyalty points and a flash-sale item), plus
    // `clientOrderId`, which the checkout double-submit fix adds. Keep this
    // list in sync with saveOrder() — an unexpected key rejects the order.
    function orderMoney(v) {
      return v is number && v >= 0 && v <= 10000000;
    }

    function orderKeysOk() {
      return request.resource.data.keys().hasAll([
               'customer','items','subtotal','discount','promoDiscount','promos',
               'delivery','total','payment','paymentStatus',
               'loyaltyRedeemedPoints','loyaltyDiscountAmount',
               'orderNum','status','isGuest','uid','createdAt'
             ])
          && request.resource.data.keys().hasOnly([
               'customer','items','subtotal','discount','promoDiscount','promos',
               'couponCode','delivery','total','payment','paymentStatus',
               'giftMessage','guestEmail','loyaltyRedeemedPoints','loyaltyDiscountAmount',
               'referrerUid','referralCode','orderNum','uid','userEmail',
               'isGuest','status','stockState','stockDeducted','createdAt','clientOrderId'
             ]);
    }

    // Optional/nullable strings are checked explicitly rather than through a
    // helper taking a field name: dynamic map indexing (data[field]) is not
    // worth relying on here, since a rules compile error would block every
    // checkout.
    function orderOptionalStrings() {
      let d = request.resource.data;
      return (!('couponCode'   in d) || d.couponCode   == null || (d.couponCode   is string && d.couponCode.size()   <= 60))
          && (!('giftMessage'  in d) || d.giftMessage  == null || (d.giftMessage  is string && d.giftMessage.size()  <= 500))
          && (!('guestEmail'   in d) || d.guestEmail   == null || (d.guestEmail   is string && d.guestEmail.size()   <= 200))
          && (!('userEmail'    in d) || d.userEmail    == null || (d.userEmail    is string && d.userEmail.size()    <= 200))
          && (!('referralCode' in d) || d.referralCode == null || (d.referralCode is string && d.referralCode.size() <= 60))
          && (!('referrerUid'  in d) || d.referrerUid  == null || (d.referrerUid  is string && d.referrerUid.size()  <= 128))
          && (!('clientOrderId' in d) || (d.clientOrderId is string && d.clientOrderId.size() <= 64));
    }

    function orderShapeOk() {
      let d = request.resource.data;
      return orderMoney(d.subtotal)
          && orderMoney(d.discount)
          && orderMoney(d.promoDiscount)
          && orderMoney(d.delivery)
          && orderMoney(d.total)
          && orderMoney(d.loyaltyDiscountAmount)
          && d.loyaltyRedeemedPoints is number
          && d.loyaltyRedeemedPoints >= 0
          && d.loyaltyRedeemedPoints <= 10000000
          // An order must arrive brand-new. Previously a client could create an
          // order that was already "delivered" (inflating their loyalty tier,
          // which admin computes from delivered spend) or already "verified".
          && d.status == 'pending'
          && d.paymentStatus in ['cod', 'pending']
          // Stock bookkeeping (see js/orders.js + admin.js deductOrderStock).
          // A client may OMIT stockState — the service worker is cache-first for
          // scripts, so returning shoppers keep running the previous orders.js
          // for a while after a deploy and still send the old stockDeducted
          // flag. admin.js reads a missing stockState as 'none', which is the
          // correct handling, so omission is safe. What a client may never do
          // is ASSERT that stock is already deducted, because that would make
          // the admin panel skip the real deduction.
          && (!('stockState' in d) || d.stockState == 'none')
          && (!('stockDeducted' in d) || d.stockDeducted is bool)
          && d.isGuest is bool
          && d.orderNum is int
          && d.orderNum > 0
          // FIRST PRODUCTION RELEASE: relaxed to a type check on purpose.
          // The stricter form is `d.createdAt == request.time`, which forces
          // serverTimestamp() and blocks a client from backdating an order.
          // It is Firebase's documented pattern, but it CANNOT be verified in
          // the Rules Playground (the document builder has no serverTimestamp
          // sentinel, so a literal timestamp can never equal request.time) —
          // its first real test would be live traffic, and if it misbehaved
          // EVERY checkout would fail. Ship the type check first, confirm real
          // orders succeed, then tighten to `== request.time` in a follow-up
          // release and re-run the live smoke test. The only protection given
          // up in the meantime is against backdated createdAt values.
          && d.createdAt is timestamp
          && d.items is list && d.items.size() > 0 && d.items.size() <= 50
          && d.promos is list && d.promos.size() <= 20
          && d.customer is map
          && d.customer.keys().hasAll(['name','mobile','address'])
          && d.customer.keys().hasOnly(['name','mobile','address','district','area'])
          && d.customer.name is string
          && d.customer.name.size() > 0 && d.customer.name.size() <= 120
          && d.customer.mobile is string
          && d.customer.mobile.size() >= 6 && d.customer.mobile.size() <= 20
          && d.customer.address is string
          && d.customer.address.size() > 0 && d.customer.address.size() <= 500
          && d.payment is map
          && d.payment.keys().hasAll(['method'])
          && d.payment.keys().hasOnly(['method','txnId','senderMobile'])
          && d.payment.method in ['COD','bKash','Nagad']
          // Internal consistency: total must equal the sum of its own parts.
          // js/orders.js builds it exactly this way (with a floor at 0), so a
          // legitimate order always satisfies this. The 1-taka tolerance
          // absorbs floating-point drift on decimal prices, and is expressed
          // as two comparisons rather than math.abs() to keep the rule on
          // constructs that are certain to compile.
          && ((d.total - (d.subtotal - d.discount - d.promoDiscount
                          - d.loyaltyDiscountAmount + d.delivery) < 1
               && (d.subtotal - d.discount - d.promoDiscount
                   - d.loyaltyDiscountAmount + d.delivery) - d.total < 1)
              || (d.total == 0
                  && (d.subtotal - d.discount - d.promoDiscount
                      - d.loyaltyDiscountAmount + d.delivery) <= 0))
          && orderOptionalStrings();
    }

    match /orders/{id} {
      // Logged-in: uid must match auth uid. Guest: isGuest==true and uid==null.
      allow create: if orderKeysOk()
                    && orderShapeOk()
                    && (
                         (isSignedIn()
                          && request.resource.data.uid == request.auth.uid
                          && request.resource.data.isGuest == false)
                      || (!isSignedIn()
                          && request.resource.data.uid == null
                          && request.resource.data.isGuest == true)
                       );

      // SEC-2 fix. This was `allow read: if true`, which made the entire order
      // book world-readable: every customer's name, mobile, full address,
      // email, order contents, bKash/Nagad sender numbers and transaction IDs,
      // plus internal adminNotes — to anyone holding the public Firebase config,
      // which ships in every page. Sequential order numbers made targeted
      // lookups trivial, and track.html's own phone fallback demonstrated the
      // hole by pulling the 200 most recent complete orders into any visitor's
      // browser.
      //
      // Guest order tracking now goes through /api/track-order, a serverless
      // function that queries with a service account and returns only
      // non-sensitive fields (status, items, totals, delivery area, masked
      // phone — never the name, street address, email or transaction ID).
      // account.html's own-order query still works: it filters on
      // where("uid","==",user.uid), which matches this rule.
      allow read:   if isOwner(resource.data.uid) || isAdmin();

      allow update, delete: if isAdmin();
    }

    // ---- Reviews -------------------------------------------------------
    // SEC-13 fix: bound the rating and pin the moderation status so a customer
    // cannot self-approve a review or store an out-of-range star value.
    // Matches the payload written by product.html.
    match /reviews/{id} {
      allow read:   if true;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.status == 'pending'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.productId != null;
      // Update is ADMIN-ONLY. The owner branch used to sit here too, entirely
      // unconstrained, which let a customer PATCH their own review with
      // status:'approved' and publish unmoderated text straight to the product
      // page and the shop's rating aggregate — self-approval, bypassing the
      // create rule's `status == 'pending'` pin. No client code ever performed
      // an owner update (product.html only addDoc()s; every updateDoc on this
      // collection is in js/admin.js behind the admin gate), so removing it
      // costs no functionality.
      allow update: if isAdmin();
      // Deleting your own review stays allowed: it grants no privilege and
      // only ever removes the author's own content.
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- Wishlist (legacy standalone collection) -----------------------
    // Superseded by users/{uid}.wishlist (js/wishlist.js). Retained so the
    // legacy wishlist.html page keeps working until it is migrated.
    match /wishlist/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ---- Site settings (homepage, banners) -----------------------------
    match /settings/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- Newsletter / contact submissions ------------------------------
    match /newsletter/{id} {
      allow create: if true;          // anyone can subscribe
      allow read, update, delete: if isAdmin();
    }
    match /messages/{id} {
      allow create: if true;          // anyone can send a contact message
      allow read, update, delete: if isAdmin();
    }

    // ---- FAQs (public read, admin write) ----------------------------------
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Stock history log (admin write, no customer access) ---------------
    match /stockHistory/{id} {
      allow read, write: if isAdmin();
    }

    // ---- Bundle deals (public read, admin write) ----------------------------
    match /bundles/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- Loyalty points ----------------------------------------------------
    // SEC-13 fix. The owner can only spend points, never mint them:
    //   * create is pinned to a zero balance (real balances are awarded by the
    //     admin flow, which runs with admin credentials)
    //   * update is restricted to the exact key set written by
    //     js/promotions.js deductLoyaltyPoints(), and `points` may only go
    //     down. The old rule constrained `points` alone, leaving `tier`,
    //     `lifetimeEarned` and `status` freely self-editable.
    match /loyaltyPoints/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isAdmin()
                    || (isOwner(uid)
                        && (!('points' in request.resource.data)
                            || request.resource.data.points == 0));
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['points','lastUpdated','lifetimeRedeemed','lastRedeemedDate'])
                        && request.resource.data.points is number
                        && request.resource.data.points >= 0
                        && request.resource.data.points <= resource.data.points);
      allow delete: if isAdmin();
    }

    // ---- Loyalty history log (owner read, admin full) -----------------------
    match /loyaltyHistory/{id} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---- Referral codes (owner read/write, public code lookup for validation)
    match /referrals/{uid} {
      allow read:   if true;
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
